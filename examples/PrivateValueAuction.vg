// First-price sealed-bid auction with private values.
//
// Each bidder privately knows what the item is worth to it (1 or 3, equally
// likely); neither sees the other's value. The bids are simultaneous, so the
// compiler commits both before either opens. The higher bid wins (ties go to
// A) and pays its bid to the Seller.
//
// Settlement moves money only. What the item is worth to its winner enters
// the analysis through the utility clause, which may read the private values
// and each role's settlement (Role.payout); the contract never sees them.

type worth = {1..3}
type bid = {0, 1, 2}

game main() {
  join Seller() $ 0 A() $ 2 B() $ 2;
  sample A(v: worth ~ uniform {1, 3});
  sample B(v: worth ~ uniform {1, 3});
  yield or split A(b: bid) B(b: bid);
  withdraw (A.b >= B.b)
      ? { Seller -> A.b; A -> 2 - A.b; B -> 2 }
      : { Seller -> B.b; A -> 2; B -> 2 - B.b }
  utility {
      A -> (A.b != null && B.b != null && A.b >= B.b) ? A.payout - 2 + A.v : A.payout - 2;
      B -> (A.b != null && B.b != null && A.b < B.b) ? B.payout - 2 + B.v : B.payout - 2;
      Seller -> Seller.payout;
  }
}
